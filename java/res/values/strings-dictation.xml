    <string name="dictation_settings_keys_import">Import keys from file</string>
    <string name="dictation_settings_keys_import_hint">Push a keys.properties file (lines: speechmatics=…, anthropic=…) to the app\'s external files directory, then tap Import. The file is deleted after import.</string>
