    <string name="dictation_settings_max_delay">Recognizer max delay</string>
    <string name="dictation_settings_max_delay_subtitle">How long Speechmatics waits for context before finalizing words. Higher = more accurate, slower to commit.</string>
    <string name="dictation_settings_idle_timeout">Idle timeout</string>
    <string name="dictation_settings_idle_timeout_subtitle">Seconds of silence before the mic stops. Any speech resets it.</string>
    <string name="dictation_settings_eou_silence">End-of-utterance silence</string>
    <string name="dictation_settings_eou_silence_subtitle">Off (0) recommended, so a pause does not force a period. If set, a pause this long makes the recognizer finalize early without the words that follow.</string>
    <string name="dictation_settings_punct">Punctuation sensitivity</string>
    <string name="dictation_settings_punct_subtitle">Lower = the recognizer adds fewer punctuation marks</string>
    <string name="dictation_settings_cleanup">LLM cleanup pass</string>
    <string name="dictation_settings_cleanup_subtitle">Minimal corrections to each finalized segment (word boundaries, misheard words, punctuation)</string>
    <string name="dictation_settings_hold_to_talk">Hold to talk</string>
    <string name="dictation_settings_hold_to_talk_subtitle">Not implemented yet. This switch has no effect; dictation is tap to start, tap to stop.</string>
    <string name="dictation_settings_fallback_mic_key">Mic key on keyboard</string>
    <string name="dictation_settings_fallback_mic_key_subtitle">Put a mic key at the bottom-left of the bottom row</string>
    <string name="dictation_settings_debug_logging">Debug logging</string>
    <string name="dictation_settings_debug_logging_subtitle">Log every partial, final, cleanup decision and timing to a local file</string>
    <string name="dictation_settings_save_audio">Save audio (debug)</string>
    <string name="dictation_settings_save_audio_subtitle">Also save raw microphone audio to the log directory. Off by default.</string>
