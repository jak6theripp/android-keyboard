    <string name="dictation_accessibility_label">Keyboard AI reply: read conversation</string>
    <string name="dictation_accessibility_summary">Lets the keyboard read the conversation on screen when you tap AI</string>
    <string name="dictation_accessibility_description">Used only by the keyboard\'s AI reply button. When you tap it, this service reads the messages visible on screen once so the reply can be drafted in context. It does not monitor the screen at any other time and does not perform actions.</string>
    <string name="dictation_settings_setup_title">Setup</string>
    <string name="dictation_settings_setup_accessibility_on">Screen reading for AI reply: ON</string>
    <string name="dictation_settings_setup_accessibility_off">Screen reading for AI reply: OFF</string>
    <string name="dictation_settings_setup_accessibility_help">To turn it on: (1) App info → ⋮ (top right) → \"Allow restricted settings\" (Android blocks accessibility for sideloaded apps until you do this). (2) Accessibility → Installed apps → \"Keyboard AI reply: read conversation\" → On. It only reads the screen at the moment you tap the AI button.</string>
    <string name="dictation_settings_setup_battery_help">Battery: in App info → Battery choose \"Unrestricted\", or One UI may stop dictation in the background.</string>
