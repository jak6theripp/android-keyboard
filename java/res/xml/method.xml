<?xml version="1.0" encoding="utf-8"?>

<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="org.futo.inputmethod.latin.uix.settings.SettingsActivity"
    android:isDefault="true"
    android:supportsSwitchingToNextInputMethod="true"
    android:supportsInlineSuggestions="true"
    android:suppressesSpellChecker="true">
    <subtype android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/english_ime_name"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:overridesImplicitlyEnabledSubtype="true" />
    <!-- Voice subtype (personal fork): if the system switches to a voice IME subtype of this
         keyboard, it starts streaming dictation. Auxiliary = never the default/typing subtype. -->
    <subtype android:icon="@drawable/mic_fill"
        android:label="@string/dictation_voice_subtype_label"
        android:imeSubtypeMode="voice"
        android:isAuxiliary="true" />
</input-method>
